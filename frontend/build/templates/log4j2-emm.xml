<?xml version="1.0" encoding="UTF-8"?>

<Configuration name="EMM" packages="">
	<!-- log4j2-emm.xml -->
	<Appenders>
		<Console name="ROOT_CONSOLE" target="SYSTEM_OUT">
			<PatternLayout pattern="%d: %-5p [%t] %c - %m%n" />
			<ThresholdFilter level="${sys:emm.log.level:-${env:EMM_LOG_LEVEL:-warn}}" onMatch="ACCEPT" onMisMatch="DENY" />
		</Console>

		<RollingFile name="APPLICATIONLOGFILE" fileName="${sys:emm.log.dir:-${env:EMM_LOG_DIR:-${sys:user.home}/logs/webapps}}/emm.log" filePattern="${sys:emm.log.dir:-${env:EMM_LOG_DIR:-${sys:user.home}/logs/webapps}}/emm.log.%d{yyyy-MM-dd}">
			<PatternLayout pattern="%d: %-5p [%t] %c - %m%n" />
			<ThresholdFilter level="${sys:emm.log.level:-${env:EMM_LOG_LEVEL:-warn}}" onMatch="ACCEPT" onMisMatch="DENY" />
			<TimeBasedTriggeringPolicy />
		</RollingFile>

		<RollingFile name="APPLICATIONERRORLOGFILE" fileName="${sys:emm.log.dir:-${env:EMM_LOG_DIR:-${sys:user.home}/logs/webapps}}/emm_error.log" filePattern="${sys:emm.log.dir:-${env:EMM_LOG_DIR:-${sys:user.home}/logs/webapps}}/emm_error.log.%d{yyyy-MM-dd}">
			<PatternLayout pattern="%d: %-5p [%t] %c - %m%n" />
			<ThresholdFilter level="error" onMatch="ACCEPT" onMisMatch="DENY" />
			<TimeBasedTriggeringPolicy />
		</RollingFile>

		<RollingFile name="CLEANLOG" fileName="${sys:emm.log.dir:-${env:EMM_LOG_DIR:-${sys:user.home}/logs/webapps}}/clean.log" filePattern="${sys:emm.log.dir:-${env:EMM_LOG_DIR:-${sys:user.home}/logs/webapps}}/clean.log.%d{yyyy-MM-dd}">
			<PatternLayout pattern="%d: %-5p [%t] %c - %m%n" />
			<ThresholdFilter level="debug" onMatch="ACCEPT" onMisMatch="DENY" />
			<TimeBasedTriggeringPolicy />
		</RollingFile>
	</Appenders>
	
	<Loggers>
		<Root level="${sys:emm.log.level:-${env:EMM_LOG_LEVEL:-warn}}">
			<AppenderRef ref="ROOT_CONSOLE" />
			<AppenderRef ref="APPLICATIONLOGFILE" />
			<AppenderRef ref="APPLICATIONERRORLOGFILE" />
		</Root>

		<Logger name="com.agnitas.emm.core.velocity" level="warn">
			<AppenderRef ref="APPLICATIONLOGFILE" />
		</Logger>

		<Logger name="com.agnitas.emm.core.velocity" level="warn">
			<AppenderRef ref="APPLICATIONLOGFILE" />
		</Logger>

		<Logger name="com.agnitas.dao.impl.DBCleanerDaoImpl" level="debug">
			<AppenderRef ref="CLEANLOG" />
		</Logger>
		
		<Logger name="com.agnitas.util.quartz.DBCleanerJobWorkerWithService" level="debug">
			<AppenderRef ref="CLEANLOG" />
		</Logger>
		
		<Logger name="com.agnitas.util.quartz.DBCleanerCompanyCleaningSubWorker" level="debug">
			<AppenderRef ref="CLEANLOG" />
		</Logger>
		
		<Logger name="de.larsgrefer.sass.embedded.SassCompiler" level="error">
			<AppenderRef ref="ROOT_CONSOLE" />
			<AppenderRef ref="APPLICATIONLOGFILE" />
			<AppenderRef ref="APPLICATIONERRORLOGFILE" />
		</Logger>
		
		<Logger name="net.htmlparser.jericho" level="OFF">
		</Logger>

<!--  BEGIN: TOTP loggin
		<Logger name="com.agnitas.emm.core.logon.web.LogonControllerExtended" level="info">
			<AppenderRef ref="TOTP_LOG" />
		</Logger>
		
		<Logger name="com.agnitas.emm.core.logon.totp.service.TotpTrustDeviceServiceImpl" level="info">
			<AppenderRef ref="TOTP_LOG" />
		</Logger>

 END: TOTP loggin -->
	</Loggers>
</Configuration>
