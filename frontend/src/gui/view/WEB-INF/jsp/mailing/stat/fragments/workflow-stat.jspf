
<%--@elvariable id="fromDate" type="java.util.Date"--%>
<%--@elvariable id="toDate" type="java.util.Date"--%>
<%--@elvariable id="isHourScale" type="java.lang.Boolean"--%>

<%@include file="mailing-stat-ajax-loader.jspf"%>

<div class="d-flex flex-column gap-3 invisible" data-controller="workflow-stat" data-initializer="workflow-stat">
    <script id="config:workflow-stat" type="application/json">
        {
            "workflowId": ${emm:toJson(statWorkflowId)},
            "from": ${emm:toJson(fromDate)},
            "to": ${emm:toJson(toDate)},
            "selectedTargets": ${emm:toJson(mailingStatisticForm.selectedTargets)}
        }
    </script>

    <div id="workflow-stat-content" class="d-contents">
        <div id="auto-optimization-info" class="hidden w-100"></div>

        <div class="w-100">
            <canvas id="workflow-stat-chart" style="height: 320px">
                <%-- Loads by JS --%>
            </canvas>
        </div>

        <div id="workflow-stat-table" class="table-wrapper w-100"></div>

        <div id="device-stat-block" class="hidden w-100">
            <div class="d-grid gap-3" style="grid-template-columns: 1fr 2fr;">
                <div class="tile tile--highlighted tile--md">
                    <div class="tile-header">
                        <h3 class="tile-title">
                            <mvc:message code="report.mailing.openersByDevices"/> &mdash; <mvc:message code="resultMailing"/>
                        </h3>
                    </div>
                    <div class="tile-body p-3">
                        <canvas id="openers-device-chart" class="h-100">
                            <%-- Loads by JS --%>
                        </canvas>
                    </div>
                </div>

                <div id="openers-device-table" class="table-wrapper h-auto"></div>

                <div class="tile tile--highlighted tile--md">
                    <div class="tile-header">
                        <h3 class="tile-title">
                            <mvc:message code="report.mailing.clickersByDevices"/> &mdash; <mvc:message code="resultMailing"/>
                        </h3>
                    </div>
                    <div class="tile-body p-3">
                        <canvas id="clickers-device-chart" class="h-100">
                            <%-- Loads by JS --%>
                        </canvas>
                    </div>
                </div>

                <div id="clickers-device-table" class="table-wrapper h-auto"></div>
            </div>
        </div>

        <div id="reactions-table-block" class="hidden w-100">
            <div id="reactions-table" class="table-wrapper h-auto"></div>
        </div>
    </div>
</div>

<template id="workflow-mailing-cell">
    <div class="d-flex gap-2 align-items-center">
        <span class="square-badge" style="background: {{= entry.color }}"></span>
        <span class="text-truncate-table">{{= value }}</span>
    </div>
</template>

<template id="stat-metric-cell">
    {{ if (value != null) { }}
        <span>
            {{ if (AGN.Lib.Helpers.isNumber(value)) { }}
                {{= AGN.formatNumber(value) }}
            {{ } else { }}
                {{= AGN.formatNumber(value.value) }} ({{= value.rate.toFixed(1) }}%)
            {{ } }}
        </span>
    {{ } }}
</template>

<template id="stat-size-cell">
    {{ if (value != null) { }}
        <span>{{= AGN.formatNumber(value) }} KB</span>
    {{ } }}
</template>

<script id="auto-optimization-info-template" type="text/x-mustache-template">
    <table class="table table--borderless">
        <thead>
        <tr>
            <th><mvc:message code="Mailing"/></th>
            <th><mvc:message code="mailing.Subject"/></th>
            <th><mvc:message code="mailing.senddate"/></th>
        </tr>
        </thead>
        <tbody>
        {{ _.each(groups, function(group) { }}
            <tr class="{{= group.finalMailing ? 'fw-bold' : '' }}">
                <td>
                    {{= group.label }}
                    {{ if (group.winner) { }}
                        <i class="icon icon-crown"></i>
                    {{ } }}
                </td>
                <td>{{= group.subject }}</td>
                <td>{{= group.sendDate }}</td>
            </tr>
        {{ }); }}
        </tbody>
        <tfoot>
        <tr><td colspan="3"></td></tr>
        </tfoot>
    </table>
</script>

<template id="device-type-label-cell">
    <div class="d-flex gap-2 align-items-center">
        <span class="square-badge badge--stat-{{= entry.color }}"></span>
        <span class="text-truncate-table">{{= value }}</span>
    </div>
</template>

<template id="stat-label-cell">
    <span class="text-truncate-table">{{= value }}</span>
</template>

<template id="stat-reaction-value-cell">
    {{ if (value != null) { }}
        <span>
            {{ if (entry.isPercent) { }}
                {{= value.toFixed(1) }}%
            {{ } else { }}
                {{= AGN.formatNumber(value) }}
            {{ } }}
        </span>
    {{ } }}
</template>

<template id="no-results-found">
    <div class="notification-simple">
        <i class="icon icon-info-circle"></i>
        <span><mvc:message code="noResultsFound" /></span>
    </div>
</template>
